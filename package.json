{
  "name": "game-deals",
  "private": true,
  "version": "1.0.0",
  "description": "Учебный проект: SPA для поиска скидок на PC-игры",
  "author": "Дьяченко Антон",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=26.8.0",
    "pnpm": ">=12.4.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/copy-404.mjs",
    "preview": "vite preview",
    "analyze": "VITE_ANALYZE=1 vite build",
    "size": "size-limit",
    "lint": "oxlint --deny-warnings",
    "deadcode": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "LIVE_API=1 vitest run src/shared/api/schemas.live.test.ts",
    "data:tags": "node scripts/build-tag-index.mjs",
    "data:snapshot": "node scripts/snapshot-prices.mjs",
    "data:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-virtual": "3.14.13",
    "chart.js": "4.5.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "14.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query-devtools": "5.103.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "jsdom": "30.1.0",
    "knip": "6.37.0",
    "oxlint": "1.83.0",
    "prettier": "3.9.8",
    "rollup-plugin-visualizer": "7.1.1",
    "size-limit": "14.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "size-limit": [
    {
      "name": "react",
      "path": "dist/assets/react-*.js",
      "limit": "70 kB"
    },
    {
      "name": "charts",
      "path": "dist/assets/charts-*.js",
      "limit": "72 kB"
    },
    {
      "name": "vendor",
      "path": "dist/assets/vendor-*.js",
      "limit": "45 kB"
    },
    {
      "name": "router",
      "path": "dist/assets/router-*.js",
      "limit": "36 kB"
    },
    {
      "name": "entry",
      "path": "dist/assets/index-*.js",
      "limit": "28 kB"
    }
  ]
}
